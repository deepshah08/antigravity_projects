an class=\"c1\">// This code is contributed by vt_m.</span>\n</pre></div></code>\n</gfg-panel>\n\n            <gfg-tab slot=\"tab\">PHP</gfg-tab>\n<gfg-panel slot=\"panel\" data-code-lang=\"php\" data-main-code-start=\"None\" data-main-code-end=\"None\">\n    <code class=\"language-php\"><div class=\"highlight\"><pre><span></span><span class=\"cp\">&lt;?php</span>\n<span class=\"c1\">// PHP implementation to print </span>\n<span class=\"c1\">// circle pattern</span>\n\n<span class=\"c1\">// Function to print circle pattern</span>\n<span class=\"k\">function</span> <span class=\"nf\">printPattern</span><span class=\"p\">(</span><span class=\"nv\">$radius</span><span class=\"p\">)</span> \n    <span class=\"p\">{</span>\n    \n    <span class=\"c1\">// dist represents distance</span>\n    <span class=\"c1\">// to the center</span>\n    <span class=\"nv\">$dist</span> <span class=\"o\">=</span> <span class=\"mf\">0.0</span><span class=\"p\">;</span>\n    \n    <span class=\"c1\">// for horizontal movement</span>\n    <span class=\"k\">for</span> <span class=\"p\">(</span><span class=\"nv\">$i</span> <span class=\"o\">=</span> <span class=\"mi\">0</span><span class=\"p\">;</span> <span class=\"nv\">$i</span> <span class=\"o\">&lt;=</span> <span class=\"mi\">2</span> <span class=\"o\">*</span> <span class=\"nv\">$radius</span><span class=\"p\">;</span> <span class=\"nv\">$i</span><span class=\"o\">++</span><span class=\"p\">)</span> \n    <span class=\"p\">{</span>\n    \n        <span class=\"c1\">// for vertical movement</span>\n        <span class=\"k\">for</span> <span class=\"p\">(</span><span class=\"nv\">$j</span> <span class=\"o\">=</span> <span class=\"mi\">0</span><span class=\"p\">;</span> <span class=\"nv\">$j</span> <span class=\"o\">&lt;=</span> <span class=\"mi\">2</span> <span class=\"o\">*</span> <span class=\"nv\">$radius</span><span class=\"p\">;</span> <span class=\"nv\">$j</span><span class=\"o\">++</span><span class=\"p\">)</span> \n        <span cl