/span><span class=\"p\">.</span><span class=\"na\">length</span><span class=\"p\">)</span><span class=\"w\"> </span><span class=\"p\">{</span>\n<span class=\"w\">            </span><span class=\"n\">res</span><span class=\"p\">.</span><span class=\"na\">add</span><span class=\"p\">(</span><span class=\"k\">new</span><span class=\"w\"> </span><span class=\"n\">ArrayList</span><span class=\"o\">&lt;&gt;</span><span class=\"p\">(</span>\n<span class=\"w\">                </span><span class=\"n\">subarr</span><span class=\"p\">));</span><span class=\"w\">  </span>\n<span class=\"w\">                          </span>\n<span class=\"w\">            </span><span class=\"k\">return</span><span class=\"p\">;</span>\n<span class=\"w\">        </span><span class=\"p\">}</span>\n\n<span class=\"w\">        </span><span class=\"c1\">// Include the current element in</span>\n<span class=\"w\">        </span><span class=\"c1\">// the subsequence</span>\n<span class=\"w\">        </span><span class=\"n\">subarr</span><span class=\"p\">.</span><span class=\"na\">add</span><span class=\"p\">(</span><span class=\"n\">arr</span><span class=\"o\">[</span><span class=\"n\">curr</span><span class=\"o\">]</span><span class=\"p\">);</span>\n\n<span class=\"w\">        </span><span class=\"c1\">// Recurse to the next element</span>\n<span class=\"w\">        </span><span class=\"n\">findSubsequences</span><span class=\"p\">(</span>\n<span class=\"w\">            </span><span class=\"n\">curr</span><span class=\"w\"> </span><span class=\"o\">+</span><span class=\"w\"> </span><span class=\"mi\">1</span><span class=\"p\">,</span><span class=\"w\"> </span><span class=\"n\">arr</span><span class=\"p\">,</span><span class=\"w\"> </span><span class=\"n\">subarr</span><span class=\"p\">,</span>\n<span class=\"w\">            </span><span class=\"n\">res</span><span class=\"p\">);</span><span class=\"w\">  </span>\n\n<span class=\"w\">        </span><span class=\"c1\">// Backtrack: Remove the current element and explore</span>\n<span class=\"w\">        </span><span class=\"c1\">// the next possibility</span>\n<span class=\"w\">        </span><span class=\"n\">subarr</span><span class=\"p\">.</span><span class=\"na\">remove</span><span class=\"p\">(</span><span class=\"n\">subarr</span><span class=\"p\">.</span><span class=\"na\">size</span><span class=\"p\">()</span><span class=\"w\"> </span><span class=\"o\">-</span><span class=\"w\"> </span><span class=\"mi\">1</span><span class=\"p\">);</span>\n\n<span class=\"w\">        </span><span class=\"c1\">//  Do not include the current</span>\n<span class=\"w\">        </span><span class=\"c1\">// element in the subsequence</span>\n<span class=\"w\">        </span><span class=\"n\">findSubsequences</span><span class=\"p\">(</span>\n<span class=\"w\">            </span><span class=\"n\">curr</span><span class=\"w\"> </span><span class=\"o\">+</span><span class=\"w\"> </span><span class=\"mi\">1</span><span class=\"p\">,</span><span class=\"w\"> </span><span class=\"n\">arr</span><span class=\"p\">,</span><span class=\"w\"> </span><span class=\"n\">subarr</span><span class=\"p\">,</span>\n<span class=\"w\">            </span><span class=\"n\">res</span><span class=\"p\">);</span><span class=\"w\">  </span>\n<span class=\"w\">                  </span>\n<span class=\"w\">    </span><span class=\"p\">}</span>\n\n<span class=\"w\">    </span><span class=\"kd\">public</span><span class=\"w\"> </span><span class=\"kd\">static</span><span class=\"w\"> </span><span class=\"kt\">void</span><span class=\"w\"> </span><span class=\"nf\">main</span><span class=\"p\">(</span><span class=\"n\">String</span><span class=\"o\">[]</span><span class=\"w\"> </span><span class=\"n\">args</span><span class=\"p\">)</span><span class=\"w\"> </span><span class=\"p\">{</span>\n<span class=\"w\">       </span>\n<span class=\"w\">        </span><span class=\"kt\">int</span><span class=\"o\">[]</span><span class=\"w\"> </span><span class=\"n\">ar