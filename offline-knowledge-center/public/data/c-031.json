quizQuestionTextContainer__question__tv5de\"><p dir=\"ltr\"><span>What is a string in C?</span></p></div></div><ul class=\"QuizQuestionCard_quizCard__optionsList__4pILJ\"><li class=\"QuizQuestionCard_quizCard__optionsList__optionItem__6OtkL false \"><div class=\"QuizQuestionCard_quizCard__optionsList__optionItem__optionInputSecond__Ye4j9 \n                                false\n                            \"></div><div class=\"QuizQuestionCard_quizCard__optionsList__optionItem__optionLabel__ZJEuI\"><div><p dir=\"ltr\"><span>special data type</span></p></div></div></li><li class=\"QuizQuestionCard_quizCard__optionsList__optionItem__6OtkL false \"><div class=\"QuizQuestionCard_quizCard__optionsList__optionItem__optionInputSecond__Ye4j9 \n                                false\n                            \"></div><div class=\"QuizQuestionCard_quizCard__optionsList__optionItem__optionLabel__ZJEuI\"><div><p dir=\"ltr\"><span>single character</span></p></div></div></li><li class=\"QuizQuestionCard_quizCard__optionsList__optionItem__6OtkL false \"><div class=\"QuizQuestionCard_quizCard__optionsList__optionItem__optionInputSecond__Ye4j9 \n                                false\n                            \"></div><div class=\"QuizQuestionCard_quizCard__optionsList__optionItem__optionLabel__ZJEuI\"><div><p dir=\"ltr\"><span>array of characters terminated by a null character</span></p></div></div></li><li class=\"QuizQuestionCard_quizCard__optionsList__optionItem__6OtkL false \"><div class=\"QuizQuestionCard_quizCard__optionsList__optionItem__optionInputSecond__Ye4j9 \n                                false\n                            \"></div><div class=\"QuizQuestionCard_quizCard__optionsList__optionItem__optionLabel__ZJEuI\"><div><p dir=\"ltr\"><span>pointer to an integer</span></p></div></div></li></ul></div><div class=\"QuizQuestionCard_quizCard__9T_0J\"><div class=\"QuizQuestionCard_quizCard__header__8owjs\"><p class=\"QuizQuestionCard_quizCard__header__questionNumber__GffEN\">Question <!-- -->2</p></div><div class=\"QuizQuestionCard_quizCard__quizQuestionTextContainer__CzNWr QuizQuestionCard_quizCard_notGfgTabs__q5ycp\"><div class=\"QuizQuestionCard_quizCard__quizQuestionTextContainer__question__tv5de\"><p dir=\"ltr\"><span>Which header file is required to use string functions like strlen() and strcpy()?</span></p></div></div><ul class=\"QuizQuestionCard_quizCard__optionsList__4pILJ\"><li class=\"QuizQuestionCard_quizCard__optionsList__optionItem__6OtkL false \"><div class=\"QuizQuestionCard_quizCard__optionsList__optionItem__optionInputSecond__Ye4j9 \n                                false\n                            \"></div><div class=\"QuizQuestionCard_quizCard__optionsList__optionItem__optionLabel__ZJEuI\"><div><p dir=\"ltr\"><span>stdlib.h</span></p></div></div></li><li class=\"QuizQuestionCard_quizCard__optionsList__optionItem__6OtkL false \"><div class=\"QuizQuestionCard_quizCard__optionsList__optionItem__optionInputSecond__Ye4j9 \n                                false\n                            \"></div><div class=\"QuizQuestionCard_quizCard__optionsList__optionItem__optionLabel__ZJEuI\"><div><p dir=\"ltr\"><span>string.h</span></p></div></div></li><li class=\"QuizQuestionCard_quizCard__optionsList__optionItem__6OtkL false \"><div class=\"QuizQuestionCard_quizCard__optionsList__optionItem__optionInputSecond__Ye4j9 \n                                false\n                            \"></div><div class=\"QuizQuestionCard_quizCard__optionsList__optionItem__optionLabel__ZJEuI\"><div><p dir=\"ltr\"><span>stdio.h</span></p></div></div></li><li class=\"QuizQuestionCard_quizCard__optionsList__optionItem__6OtkL false \"><div class=\"QuizQuestionCard_quizCard__optionsList__optionItem__optionInputSecond__Ye4j9 \n                                false\n                            \"></div><div class=\"QuizQuestionCard_quizCard__optionsList__optionItem__optionLabel__ZJEuI\"><div><p dir=\"ltr\"><span>conio.h</span></p></div></div></li></ul></div><div class=\"QuizQuestionCard_quizCard__9T_0J\"><div class=\"QuizQuestionCard_quizCard__header__8owjs\"><p class=\"QuizQuestionCard_quizCard__header__questionNumber__GffEN\">Question <!-- -->3</p></div><div class=\"QuizQuestionCard_quizCard__quizQuestionTextContainer__CzNWr QuizQuestionCard_quizCard_notGfgTabs__q5ycp\"><div class=\"QuizQuestionCard_quizCard__quizQuestionTextContainer__question__tv5de\"><p dir=\"ltr\"><span>What is the output?</span></p><gfg-tabs data-run-ide=\"false\">\n        <gfg-tab slot=\"tab\">C</gfg-tab>\n        <gfg-panel slot=\"panel\" data-code-lang=\"c\">\n        <code class=\"language-c\"><div class=\"highlight\"><pre><span></span><span class=\"cp\">#include</span><span class=\"w\"> </span><span class=\"cpf\">&lt;stdio.h&gt;</span>\n<span class=\"cp\">#include</span><span class=\"w\"> </span><span class=\"cpf\">&lt;string.h&gt;</span>\n\n<span class=\"kt\">int</span><span class=\"w\"> </span><span class=\"nf\">main</span><span class=\"p\">()</span><span class=\"w\"> </span><span class=\"p\">{</span>\n<span class=\"w\">    </span><span class=\"n\">printf</span><span class=\"p\">(</span><span class=\"s\">\"%ld\"</span><span class=\"p\">,</span><span class=\"w\"> </span><span class=\"n\">strlen</span><span class=\"p\">(</span><span class=\"s\">\"Hello\"</span><span class=\"p\">));</span>\n<span class=\"w\">    </span><span class=\"k\">return</span><span class=\"w\"> </span><span class=\"mi\">0</span><span class=\"p\">;</span>\n<span class=\"p\">}</span>\n</pre></div></code>\n        </gfg-panel>\n    </gfg-tabs><p><br></p></div></div><ul class=\"QuizQuestionCard_quizCard__optionsList__4pILJ\"><li class=\"QuizQuestionCard_quizCard__optionsList__optionItem__6OtkL false \"><div class=\"QuizQuestionCard_quizCard__optionsList__optionItem__optionInputSecond__Ye4j9 \n                                false\n                            \"></div><div class=\"QuizQuestionCard_quizCard__optionsList__optionItem__optionLabel__ZJEuI\"><div><p><span>4</span></p></div></div></li><li class=\"QuizQuestionCard_quizCard__optionsList__optionItem__6OtkL false \"><div class=\"QuizQuestionCard_quizCard__optionsList__optionItem__optionInputSecond__Ye4j9 \n                                false\n                            \"></div><div class=\"QuizQuestionCard_quizCard__optionsList__optionItem__optionLabel__ZJEuI\"><div><p><span>5</span></p></div></div></li><li class=\"QuizQuestionCard_quizCard__optionsList__optionItem__6OtkL false \"><div class=\"QuizQuestionCard_quizCard__optionsList__optionItem__optionInputSecond__Ye4j9 \n                                false\n                            \"></div><div class=\"QuizQuestionCard_quizCard__optionsList__optionItem__optionLabel__ZJEuI\"><div><p><span>6</span></p></div></div></li><li class=\"QuizQuestionCard_quizCard__optionsList__optionItem__6OtkL false \"><div class=\"QuizQuestionCard_quizCard__optionsList__optionItem__optionInputSecond__Ye4j9 \n                                false\n                            \"></div><div class=\"QuizQuestionCard_quizCard__optionsList__optionItem__optionLabel__ZJEuI\"><div><p dir=\"ltr\"><span>Compilation Error</span></p></div></div></li></ul></div><div class=\"QuizQuestionCard_quizCard__9T_0J\"><div class=\"QuizQuestionCard_quizCard__header__8owjs\"><p class=\"QuizQuestionCard_quizCard__header__questionNumber__GffEN\">Question <!-- -->4</p></div><div class=\"QuizQuestionCard_quizCard__quizQuestionTextContainer__CzNWr QuizQuestionCard_quizCard_notGfgTabs__q5ycp\"><div class=\"QuizQuestionCard_quizCard__quizQuestionTextContainer__question__tv5de\"><p dir=\"ltr\"><span>Which of the following correctly declares a string in C?</span></p><p><br></p></div></div><ul class=\"QuizQuestionCard_quizCard__optionsList__4pILJ\"><li class=\"QuizQuestionCard_quizCard__optionsList__optionItem__6OtkL false \"><div class=\"QuizQuestionCard_quizCard__optionsList__optionItem__optionInputSecond__Ye4j9 \n                                false\n                            \"></div><div class=\"QuizQuestionCard_quizCard__optionsList__optionItem__optionLabel__ZJEuI\"><div><p dir=\"ltr\"><span>char name = \"John\";</span></p></div></div></li><li class=\"QuizQuestionCard_quizCard__optionsList__optionItem__6OtkL false \"><div class=\"QuizQuestionCard_quizCard__optionsList__optionItem__optionInputSecond__Ye4j9 \n                                false\n                            \"></div><div class=\"QuizQuestionCard_quizCard__optionsList__optionItem__optionLabel__ZJEuI\"><div><p dir=\"ltr\"><span>string name = \"John\";</span></p></div></div></li><li class=\"QuizQuestionCard_quizCard__optionsList__optionItem__6OtkL false \"><div class=\"QuizQuestionCard_quizCard__optionsList__optionItem__optionInputSecond__Ye4j9 \n                                false\n                            \"></div><div class=\"QuizQuestionCard_quizCard__optionsList__optionItem__optionLabel__ZJEuI\"><div><p dir=\"ltr\"><span>char name[] = \"John\";</span></p></div></div></li><li class=\"QuizQuestionCard_quizCard__optionsList__optionItem__6OtkL false \"><div class=\"QuizQuestionCard_quizCard__optionsList__optionItem__optionInputSecond__Ye4j9 \n                                false\n                            \"></div><div class=\"QuizQuestionCard_quizCard__optionsList__optionItem__optionLabel__ZJEuI\"><div><p dir=\"ltr\"><span>char name ={ 'J', 'o', 'h', 'n', '\\0' };</span></p></div></div></li></ul></div><div class=\"QuizQuestionCard_quizCard__9T_0J\"><div class=\"QuizQuestionCard_quizCard__header__8owjs\"><p class=\"QuizQuestionCard_quizCard__header__questionNumber__GffEN\">Question <!-- -->5</p></div><div class=\"QuizQuestionCard_quizCard__quizQuestionTextContainer__CzNWr QuizQuestionCard_quizCard_notGfgTabs__q5ycp\"><div class=\"QuizQuestionCard_quizCard__quizQuestionTextContainer__question__tv5de\"><p dir=\"ltr\"><span> What does the '\\0' character indicate in a C string?</span></p></div></div><ul class=\"QuizQuestionCard_quizCard__optionsList__4pILJ\"><li class=\"QuizQuestionCard_quizCard__optionsList__optionItem__6OtkL false \"><div class=\"QuizQuestionCard_quizCard__optionsList__optionItem__optionInputSecond__Ye4j9 \n                                false\n                            \"></div><div class=\"QuizQuestionCard_quizCard__optionsList__optionItem__optionLabel__ZJEuI\"><div><p dir=\"ltr\"><span>Space</span></p></div></div></li><li class=\"QuizQuestionCard_quizCard__optionsList__optionItem__6OtkL false \"><div class=\"QuizQuestionCard_quizCard__optionsList__optionItem__optionInputSecond__Ye4j9 \n                                false\n                            \"></div><div class=\"QuizQuestionCard_quizCard__optionsList__optionItem__optionLabel__ZJEuI\"><div><p dir=\"ltr\"><span>End of file</span></p></div></div></li><li class=\"QuizQuestionCard_quizCard__optionsList__optionItem__6OtkL false \"><div class=\"QuizQuestionCard_quizCard__optionsList__optionItem__optionInputSecond__Ye4j9 \n                                false\n                            \"></div><div class=\"QuizQuestionCard_quizCard__optionsList__optionItem__optionLabel__ZJEuI\"><div><p dir=\"ltr\"><span>End of string</span></p></div></div></li><li class=\"QuizQuestionCard_quizCard__optionsList__optionItem__6OtkL false \"><div class=\"QuizQuestionCard_quizCard__optionsList__optionItem__optionInputSecond__Ye4j9 \n                                false\n                            \"></div><div class=\"QuizQuestionCard_quizCard__optionsList__optionItem__optionLabel__ZJEuI\"><div><p dir=\"ltr\"><span>Null string</span></p></div></div></li></ul></div><div class=\"QuizQuestionCard_quizCard__9T_0J\"><div class=\"QuizQuestionCard_quizCard__header__8owjs\"><p class=\"QuizQuestionCard_quizCard__header__questionNumber__GffEN\">Question <!-- -->6</p></div><div class=\"QuizQuestionCard_quizCard__quizQuestionTextContainer__CzNWr QuizQuestionCard_quizCard_notGfgTabs__q5ycp\"><div class=\"QuizQuestionCard_quizCard__quizQuestionTextContainer__